<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPFの初期化前にmanifestでDPIを確定する。WinForms用の遅延設定は使わない。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.2-dev.9</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.2.9</FileVersion>
    <Product>LinkLauncher</Product>
    <Description>案件と種類で整理するWindows用リンクランチャー</Description>
    <Company>LinkLauncher</Company>
    <Authors>Fumiya</Authors>
    <Copyright>Copyright (c) 2026 LinkLauncher contributors</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/LinkLauncher.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/LinkLauncher.ico" /></ItemGroup>
</Project>
