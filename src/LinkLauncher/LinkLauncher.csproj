<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPFの初期化前にmanifestでDPIを確定する。WinForms用の遅延設定は使わない。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.2</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
    <Product>LinkLauncher</Product>
    <Description>案件と種類で整理するWindows用リンクランチャー</Description>
    <Company>LinkLauncher</Company>
    <Authors>Fumiya</Authors>
    <Copyright>Copyright (c) 2026 LinkLauncher contributors</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/LinkLauncher.ico</ApplicationIcon>
    <InputBridgeOutputDirectory>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\InputBridge\</InputBridgeOutputDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/LinkLauncher.ico" />
    <!-- 不成立だった受け窓方式は純fake試験用にソースを保持し、本体には含めない。 -->
    <Compile Remove="Services/ChordReleaseReceiver.cs" />
    <None Include="$(InputBridgeOutputDirectory)LinkLauncher.MouseHook.x64.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="LinkLauncher.MouseHook.x64.dll"
          TargetPath="LinkLauncher.MouseHook.x64.dll" />
  </ItemGroup>

  <Target Name="BuildInputBridge" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Build-InputBridge.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\$(InputBridgeOutputDirectory).&quot;" />
  </Target>
</Project>
