<Window x:Class="LinkLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:LinkLauncher"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="LinkLauncher" Width="700" Height="440" MinWidth="520" MinHeight="320"
 WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
 AllowDrop="True" PreviewKeyDown="Window_KeyDown" Drop="Window_Drop" DragOver="Window_DragOver"
 MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
 Deactivated="Window_Deactivated" Closing="Window_Closing">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="5" />
 </shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource WindowBackground}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="37" /><RowDefinition Height="*" /><RowDefinition Height="25" /></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="7,0" Background="Transparent" MouseLeftButtonDown="Title_MouseDown">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="CategoriesButton" Content="☰" Style="{StaticResource QuietButton}" Padding="7,4" FontSize="16"
      Click="Categories_Click" ToolTip="カテゴリ欄をたたむ／表示する" AutomationProperties.Name="カテゴリ欄をたたむ／表示する" />
     <TextBlock Text="LinkLauncher" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,13,0" />
    </StackPanel>
    <TextBlock Grid.Column="1" x:Name="ViewTitle" Text="すべてのリンク" Foreground="{DynamicResource Muted}"
     FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="PinButton" Content="固定" Style="{StaticResource QuietButton}" Padding="7,4" FontSize="11"
      Click="Pin_Click" ToolTip="別の画面をクリックしても閉じない" />
     <Button Content="⚙" Style="{StaticResource QuietButton}" Padding="7,4" Click="Settings_Click" ToolTip="設定" AutomationProperties.Name="設定" />
     <Button Content="×" Style="{StaticResource QuietButton}" Padding="8,2" FontSize="19" Click="Hide_Click"
      ToolTip="閉じて常駐" AutomationProperties.Name="閉じて常駐" />
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="CategoryColumn" Width="164" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border x:Name="CategoryPane" Grid.Column="0" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
     <Grid Margin="7,3,7,6">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="31" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
       <Button x:Name="AllButton" Style="{StaticResource SidebarButton}" Click="All_Click" FontSize="12" Height="28" Margin="0,0,0,2" Content="▦  すべて" />
       <Button x:Name="FavoritesButton" Style="{StaticResource SidebarButton}" Click="Favorites_Click" FontSize="12" Height="28" Margin="0,0,0,2" Content="☆  お気に入り" />
       <Button x:Name="RecentButton" Style="{StaticResource SidebarButton}" Click="Recent_Click" FontSize="12" Height="28" Content="◷  最近使ったリンク" />
      </StackPanel>
      <DockPanel Grid.Row="1" Margin="8,3,1,1">
       <Button DockPanel.Dock="Right" Content="＋" Padding="5,0" FontSize="16" Style="{StaticResource QuietButton}"
        Click="AddCategory_Click" ToolTip="カテゴリを追加" AutomationProperties.Name="カテゴリを追加" />
       <TextBlock Text="カテゴリ" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" />
      </DockPanel>
      <TreeView x:Name="CategoryTree" Grid.Row="2" Background="Transparent" BorderThickness="0" FontSize="12"
       Foreground="{DynamicResource Ink}" SelectedItemChanged="CategoryTree_SelectedItemChanged" HorizontalContentAlignment="Stretch"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
       PreviewMouseLeftButtonDown="CategoryOrder_MouseDown" PreviewMouseMove="CategoryOrder_MouseMove" PreviewMouseLeftButtonUp="CategoryOrder_MouseUp"
       PreviewDragOver="CategoryOrder_DragOver" PreviewDragLeave="CategoryOrder_DragLeave" PreviewDrop="CategoryOrder_Drop"
       ToolTip="カテゴリは同じ階層内でドラッグして並べ替えできます。">
       <TreeView.Resources>
        <Style TargetType="TreeViewItem">
         <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
         <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
         <Setter Property="Foreground" Value="{DynamicResource Ink}" />
         <Setter Property="HorizontalContentAlignment" Value="Stretch" />
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
           <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
           <ToggleButton x:Name="Expander" Width="12" Height="24" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" Focusable="False">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
             <Border Background="Transparent"><Path x:Name="Arrow" Data="M 3,2 L 7,6 L 3,10" Stroke="{DynamicResource Muted}" StrokeThickness="1.3"
              Width="9" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" /></Border>
             <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
           </ToggleButton>
           <Border x:Name="HeaderFrame" Grid.Column="1" Background="Transparent" BorderBrush="{DynamicResource Accent}" BorderThickness="0" CornerRadius="4" Padding="4,4">
            <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch" />
           </Border>
           <ItemsPresenter x:Name="ChildItems" Grid.Row="1" Grid.Column="1" />
          </Grid>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
           <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="{DynamicResource SelectedSurface}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Trigger>
           <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ChildItems" Property="Visibility" Value="Collapsed" /></Trigger>
           <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Setter.Value></Setter>
        </Style>
       </TreeView.Resources>
       <TreeView.ItemTemplate>
        <HierarchicalDataTemplate DataType="{x:Type local:CategoryNode}" ItemsSource="{Binding Children}">
         <Grid Background="Transparent" MouseRightButtonUp="Category_RightClick" ToolTip="{Binding Path}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="5,0,1,0" VerticalAlignment="Center" />
         </Grid>
        </HierarchicalDataTemplate>
       </TreeView.ItemTemplate>
      </TreeView>
     </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="10,2,10,0">
     <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="31" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <Grid Grid.Row="0" Margin="0,0,0,4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
      <Border x:Name="SearchFrame" Background="{DynamicResource Surface}" CornerRadius="5" BorderThickness="1"
       PreviewMouseLeftButtonDown="SearchFrame_MouseDown">
       <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
         <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </DataTrigger></Style.Triggers>
       </Style></Border.Style>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="29" /><ColumnDefinition Width="*" /><ColumnDefinition Width="27" /></Grid.ColumnDefinitions>
        <Path Data="M 8,2 A 6,6 0 1 0 8,14 A 6,6 0 1 0 8,2 M 12,12 L 18,18" Width="15" Height="15"
         Stroke="{DynamicResource SearchIcon}" StrokeThickness="1.6" Stretch="Uniform" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0" Padding="0,5" FontSize="13" Background="Transparent"
         TextChanged="Search_TextChanged" AutomationProperties.Name="すべてのリンクを検索" />
        <TextBlock Grid.Column="1" x:Name="SearchPlaceholder" Text="名前・タグ・案件名を検索" Foreground="{DynamicResource SearchHint}" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
           <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
           <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False" />
          </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers>
         </Style></TextBlock.Style>
        </TextBlock>
        <Button Grid.Column="2" Content="×" Style="{StaticResource QuietButton}" Padding="5,2" Click="ClearSearch_Click" ToolTip="検索をクリア" AutomationProperties.Name="検索をクリア" />
       </Grid>
      </Border>
      <Button Grid.Column="1" Content="＋" Style="{StaticResource PrimaryButton}" Padding="0" Margin="5,0,0,0" FontSize="17"
       Click="AddLink_Click" ToolTip="リンクを追加" AutomationProperties.Name="リンクを追加" />
     </Grid>
     <DockPanel Grid.Row="1" Margin="0,0,0,6">
      <TextBlock DockPanel.Dock="Right" x:Name="ResultCount" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" Margin="5,0,0,0" />
      <StackPanel Orientation="Horizontal">
       <Button x:Name="TypeAll" Content="すべて" Tag="All" Click="Type_Click" Padding="7,2" FontSize="11" Margin="0,0,4,0" />
       <Button x:Name="TypeWeb" Content="Web" Tag="Web" Click="Type_Click" Padding="7,2" FontSize="11" Margin="0,0,4,0" />
       <Button x:Name="TypeFile" Content="ファイル" Tag="File" Click="Type_Click" Padding="7,2" FontSize="11" Margin="0,0,4,0" />
       <Button x:Name="TypeFolder" Content="フォルダ" Tag="Folder" Click="Type_Click" Padding="7,2" FontSize="11" />
      </StackPanel>
     </DockPanel>
     <Grid Grid.Row="2" Margin="0,0,0,5">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5">
       <ListBox x:Name="LinkList" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" Padding="3"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
        AllowDrop="True" PreviewMouseLeftButtonDown="LinkList_MouseDown" PreviewMouseLeftButtonUp="LinkList_MouseUp"
        PreviewMouseMove="LinkOrder_MouseMove" PreviewDragOver="LinkOrder_DragOver" PreviewDragLeave="LinkOrder_DragLeave" PreviewDrop="LinkOrder_Drop"
        PreviewMouseRightButtonUp="LinkList_RightClick" ToolTip="リンクをドラッグして並べ替えます。最近使ったリンクでは順序を変更できません。">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
         <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,1" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource Accent}" BorderThickness="0" CornerRadius="3" Height="32" Padding="5,0">
           <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
           <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedSurface}" /></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Setter.Value></Setter>
        </Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate DataType="{x:Type local:LinkRow}">
         <Grid Height="32" Cursor="Hand" ToolTipService.InitialShowDelay="500" ToolTipService.ShowDuration="20000">
          <Grid.ToolTip>
           <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <StackPanel MaxWidth="360">
             <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
             <TextBlock Text="{Binding Target}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
             <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
             <StackPanel Margin="0,9,0,0">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" />
               <Style.Triggers><DataTrigger Binding="{Binding HasNote}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
              </Style></StackPanel.Style>
              <TextBlock Text="メモ" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,0,0,3" />
              <TextBlock Text="{Binding Note}" TextWrapping="Wrap" MaxHeight="180" TextTrimming="CharacterEllipsis" />
             </StackPanel>
            </StackPanel>
           </ToolTip>
          </Grid.ToolTip>
          <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /><ColumnDefinition Width="14" /><ColumnDefinition Width="27" /><ColumnDefinition Width="23" /></Grid.ColumnDefinitions>
          <Border Width="21" Height="21" Background="{Binding IconBackground}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
           <TextBlock Text="{Binding Glyph}" FontSize="12" Foreground="{Binding IconForeground}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,7,0" />
          <TextBlock Grid.Column="2" Text="{Binding CategoryName}" Foreground="{DynamicResource DetailInk}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,4,0" />
          <TextBlock Grid.Column="3" Text="▤" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center">
           <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" />
            <Style.Triggers><DataTrigger Binding="{Binding HasNote}" Value="False"><Setter Property="Visibility" Value="Hidden" /></DataTrigger></Style.Triggers>
           </Style></TextBlock.Style>
          </TextBlock>
          <Button Grid.Column="4" Content="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteForeground}" Style="{StaticResource QuietButton}"
           FontSize="15" Padding="3,2" Click="Favorite_Click" ToolTip="お気に入りを切り替え" AutomationProperties.Name="お気に入りを切り替え" />
          <Button Grid.Column="5" Content="⋯" Style="{StaticResource QuietButton}" FontSize="18" Padding="2,0"
           Click="LinkMenu_Click" ToolTip="リンクの操作" AutomationProperties.Name="リンクの操作" />
         </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Border>
      <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
       <TextBlock x:Name="EmptyTitle" Text="リンクを登録しましょう" FontWeight="SemiBold" FontSize="14" TextAlignment="Center" />
       <TextBlock x:Name="EmptyDescription" Text="ファイルやフォルダをここにドロップできます。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,12" />
       <Button Content="リンクを追加" Click="AddLink_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" FontSize="12" Padding="10,5" />
      </StackPanel>
     </Grid>
     <Border Grid.Row="3" x:Name="NoticePanel" Visibility="Collapsed" Background="{DynamicResource NoticeSurface}" CornerRadius="4" Padding="8,5" Margin="0,2,0,5">
      <DockPanel><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource QuietButton}" Padding="4,0" Click="DismissNotice_Click" />
       <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="11" /></DockPanel>
     </Border>
    </Grid>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10,0">
    <DockPanel VerticalAlignment="Center">
     <TextBlock DockPanel.Dock="Right" x:Name="BuildLabel" Foreground="{DynamicResource FooterInk}" FontSize="10" Margin="10,0,0,0" />
     <TextBlock DockPanel.Dock="Right" x:Name="ActivationHint" Foreground="{DynamicResource FooterInk}" FontSize="10" />
     <TextBlock x:Name="SaveStatus" Text="● 保存済み" Foreground="{DynamicResource SaveInk}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="登録データはこのPCに保存します。ドラッグで順序変更 / ↑↓ 選択 / Enter 開く / Esc 閉じる" />
    </DockPanel>
   </Border>
  </Grid>
 </Border>
</Window>
